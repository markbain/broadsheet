{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "78rem",
			"wideSize": "90rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"palette": [
				{
					"slug": "base",
					"color": "#F4F2ED",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#14120F",
					"name": "Contrast"
				},
				{
					"slug": "accent-1",
					"color": "#E8380D",
					"name": "Accent 1"
				},
				{
					"slug": "accent-1-text",
					"color": "#C42B08",
					"name": "Accent 1 (text)"
				},
				{
					"slug": "accent-2",
					"color": "#2939E6",
					"name": "Accent 2"
				},
				{
					"slug": "accent-3",
					"color": "#F5C518",
					"name": "Accent 3"
				},
				{
					"slug": "muted",
					"color": "#736C5D",
					"name": "Muted"
				},
				{
					"slug": "surface",
					"color": "#DDD9D1",
					"name": "Surface"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"dropCap": false,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Big Shoulders Display\", \"Arial Narrow\", Haettenschweiler, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Big Shoulders Display",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/big-shoulders-display-700.woff2"
							]
						},
						{
							"fontFamily": "Big Shoulders Display",
							"fontWeight": "900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/big-shoulders-display-900.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"Martian Mono\", ui-monospace, \"Courier New\", monospace",
					"fontFace": [
						{
							"fontFamily": "Martian Mono",
							"fontWeight": "300",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/martian-mono-300.woff2"
							]
						},
						{
							"fontFamily": "Martian Mono",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/martian-mono-400.woff2"
							]
						},
						{
							"fontFamily": "Martian Mono",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/martian-mono-600.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "label",
					"name": "Label",
					"size": "0.6875rem",
					"fluid": false
				},
				{
					"slug": "body",
					"name": "Body",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "d-4",
					"name": "Card title",
					"size": "1.625rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.625rem"
					}
				},
				{
					"slug": "d-3",
					"name": "Row title",
					"size": "2.25rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "d-2",
					"name": "Section",
					"size": "3.375rem",
					"fluid": {
						"min": "2rem",
						"max": "3.375rem"
					}
				},
				{
					"slug": "d-1",
					"name": "Statement",
					"size": "3.875rem",
					"fluid": {
						"min": "2.125rem",
						"max": "3.875rem"
					}
				},
				{
					"slug": "d-xl",
					"name": "Wordmark",
					"size": "5.75rem",
					"fluid": {
						"min": "2.125rem",
						"max": "5.75rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1 - Tight",
					"size": "clamp(0.75rem, 1.2vw, 1rem)"
				},
				{
					"slug": "30",
					"name": "2 - Cell",
					"size": "clamp(1.25rem, 1.9vw, 1.625rem)"
				},
				{
					"slug": "40",
					"name": "3 - Pad",
					"size": "clamp(1.5rem, 2.6vw, 2.5rem)"
				},
				{
					"slug": "50",
					"name": "4 - Section",
					"size": "clamp(2rem, 4vw, 3.5rem)"
				},
				{
					"slug": "60",
					"name": "5 - Break",
					"size": "clamp(3rem, 6vw, 5.75rem)"
				},
				{
					"slug": "70",
					"name": "6 - Pause",
					"size": "clamp(6.875rem, 15vw, 15.625rem)"
				},
				{
					"slug": "80",
					"name": "7 - Silence",
					"size": "clamp(9rem, 20vw, 20rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": false,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"background": {
			"backgroundImage": false
		},
		"custom": {
			"gutter": "clamp(1.25rem, 5.2vw, 6rem)",
			"hairline": "1px",
			"button": {
				"paddingBlock": "1.25em",
				"paddingInline": "1.625em",
				"outlineWidth": "2px"
			},
			"slip": {
				"offset": "0.26em",
				"counter": "-0.12em"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mono)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"fontWeight": "300",
			"lineHeight": "1.8",
			"letterSpacing": "-0.01em"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			},
			"blockGap": "var(--wp--preset--spacing--40)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-1)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900",
					"lineHeight": "0.92",
					"letterSpacing": "0.005em",
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--d-xl)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--d-1)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--d-2)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--d-3)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--d-4)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--contrast)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"fontWeight": "600",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase",
					"textDecoration": "none"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--button--padding-block)",
						"bottom": "var(--wp--custom--button--padding-block)",
						"left": "var(--wp--custom--button--padding-inline)",
						"right": "var(--wp--custom--button--padding-inline)"
					}
				},
				"border": {
					"radius": "0px"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-1-text)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/image": {
				"border": {
					"radius": "0px"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "var(--wp--preset--font-size--d-3)",
					"textTransform": "uppercase"
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--d-2)"
				}
			},
			"core/gallery": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0",
						"left": "0",
						"right": "0"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var(--wp--preset--color--contrast)",
						"style": "solid",
						"width": "var(--wp--custom--hairline)"
					},
					"bottom": {
						"color": "var(--wp--preset--color--contrast)",
						"style": "solid",
						"width": "var(--wp--custom--hairline)"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "900",
					"fontSize": "var(--wp--preset--font-size--d-2)",
					"lineHeight": "0.92",
					"letterSpacing": "0.005em",
					"textTransform": "uppercase"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"color": "var(--wp--preset--color--contrast)",
					"style": "solid",
					"width": "var(--wp--custom--hairline)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--body)"
				},
				"spacing": {
					"padding": "var(--wp--preset--spacing--30)"
				}
			},
			"core/table": {
				"css": "& td, & th { border-color: var(--wp--preset--color--muted); } & thead { border-block-end: var(--wp--custom--hairline) solid var(--wp--preset--color--contrast); } & th { font-family: var(--wp--preset--font-family--mono); font-size: var(--wp--preset--font-size--label); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--wp--preset--color--muted); }"
			},
			"core/calendar": {
				"css": "& table:not(.has-text-color) { color: var(--wp--preset--color--contrast); } & table:not(.has-text-color) td, & table:not(.has-text-color) th { border-color: var(--wp--preset--color--muted); } & table:not(.has-background) th { background-color: var(--wp--preset--color--contrast); color: var(--wp--preset--color--base); font-family: var(--wp--preset--font-family--mono); font-size: var(--wp--preset--font-size--label); letter-spacing: 0.16em; text-transform: uppercase; }"
			},
			"core/search": {
				"border": {
					"color": "var(--wp--preset--color--contrast)",
					"style": "solid",
					"width": "var(--wp--custom--hairline)",
					"radius": "0px"
				}
			},
			"core/tag-cloud": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"core/categories": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/archives": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/latest-posts": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"core/latest-comments": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--label)"
				}
			},
			"core/post-author": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)"
				}
			},
			"core/post-author-name": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/post-author-biography": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--body)"
				}
			},
			"core/post-comments-count": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/post-comments-link": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/post-time-to-read": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/comments-title": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/comment-date": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/comment-edit-link": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			},
			"core/comment-reply-link": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"textTransform": "uppercase",
					"letterSpacing": "0.16em"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page, no title",
			"postTypes": [
				"page"
			]
		}
	]
}
